<% const nav=[['/','home','Inicio'],['/catalogo','catalogo','Catálogo'],['/mis-pedidos','pedidos','Mis Pedidos'],['/notificaciones','notificaciones','Notificaciones'],['/admin','admin','Panel Admin']]; %>
<header class="fixed top-0 inset-x-0 z-50 bg-white/90 backdrop-blur shadow-sm">
 <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between gap-4">
  <a href="/" class="font-head font-bold text-primary leading-tight">Campus Store<span class="block text-[10px] uppercase tracking-wider text-gray-500 font-sans">Tienda Universitaria</span></a>
  <nav class="hidden lg:flex gap-1">
   <% nav.forEach(([h,k,t]) => { %><a href="<%= h %>" class="px-4 py-2 rounded-lg text-sm font-semibold <%= active===k ? 'bg-primary text-white' : 'text-gray-600 hover:bg-line' %>"><%= t %></a><% }) %>
  </nav>
  <div class="flex items-center gap-3">
   <div id="svc-status" class="hidden 2xl:flex gap-1 text-[10px] font-mono"></div>
   <a href="/checkout" class="relative p-2 rounded-full hover:bg-line"><span class="material-symbols-outlined">shopping_bag</span><span id="cart-count" class="absolute top-0 right-0 w-4 h-4 bg-gold text-[10px] font-bold rounded-full flex items-center justify-center">0</span></a>
   <div class="hidden lg:block text-sm leading-tight"><b id="user-name">—</b><span id="user-fac" class="block text-xs text-amber-700 font-bold"></span></div>
  </div>
 </div>
</header>
